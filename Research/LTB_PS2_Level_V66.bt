struct Node {
    int PolyIndex;
    int LeafIndex;
    int NodeIndexes[2];
};

struct UserPortal {
    LTString Name;
    int Unk1;
    int Unk2;
    ushort Unk3;
    LTVector Center;
    LTVector Dims;
};

struct PBlockHeader {
    int Padding;
    short Size;
    short Unk1;
};

struct PBlockTable (int PolyCount) {
    int Unk1;
    int Unk2;
    int Unk3;

    local int Size = Unk1*Unk2*Unk3;
    
    // Wenn alle drei Werte 0 sind, abbrechen
    if (Size == 0) {
        Warning("PBlockTable Size is 0, skipping");
        return;
    }
    
    LTVector Unk4;
    LTVector Unk5;
    uint TotalDataSize;
    
    if (TotalDataSize > 0) {
        uchar Block[TotalDataSize * 6] <optimize=false>;
    }

    PBlockHeader BlockHeaders[Size];
};



