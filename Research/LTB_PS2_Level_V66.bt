struct WorldBSP {

    LTString WorldName;

    int InfoFlags;
    int Unknown;

    int PointCount;
    int PlaneCount;
    int SurfaceCount;
    int UserPortalCount;
    int PolyCount;
    int LeafCount;
    int VertCount;
    int TotalVisListSize;
    int LeafListCount;
    int NodeCount;

    int __ValueIsZero;
    int __AnItemCount;

    LTVector MinBox;
    LTVector MaxBox;
    LTVector WorldTranslation;

    uchar TextureNameLength;
    uchar TextureCount;
    short Unknown4;


    // =====================================================
    // VERTICES
    // =====================================================

    Vertex Vertices[PolyCount];


    // =====================================================
    // LEAVES
    // =====================================================

    if (LeafCount > 0) {
        Leaf LeafList[LeafCount] <optimize=false>;
    }


    // =====================================================
    // PLANES
    // =====================================================

    Plane Planes[PlaneCount];


    // =====================================================
    // SURFACES
    // =====================================================

    Surface Surfaces[SurfaceCount] <optimize=false>;


    // =====================================================
    // KOMPAKTE ANALYSE
    // =====================================================

    Printf("\n");
    Printf("===== MODEL =====\n");

    Printf("WorldName: %s\n", WorldName.Value);
    Printf("Surfaces: %d | Polygons: %d\n",
        SurfaceCount,
        PolyCount);


        // ------------------------------------------------------------
    // TARGET SURFACES
    // Texture 50 = tex\stone\st19\st1003.dtx
    // Texture 51 = tex\stone\st19\st1004.dtx
    // ------------------------------------------------------------

    for (local int j = 0; j < SurfaceCount; j++) {

        if (Surfaces[j].Texture == 50 ||
            Surfaces[j].Texture == 51) {

            Printf("\n");
            Printf("==================================================\n");
            Printf("TARGET SURFACE %d\n", j);
            Printf("==================================================\n");

            Printf("Texture    = %d\n", Surfaces[j].Texture);
            Printf("Flags      = 0x%08X\n", Surfaces[j].Flags);
            Printf("StartIndex = %d\n", Surfaces[j].StartIndex);

            Printf("O = (%f, %f, %f)\n",
                Surfaces[j].UV1.x,
                Surfaces[j].UV1.y,
                Surfaces[j].UV1.z);

            Printf("P = (%f, %f, %f)\n",
                Surfaces[j].UV2.x,
                Surfaces[j].UV2.y,
                Surfaces[j].UV2.z);

            Printf("Q = (%f, %f, %f)\n",
                Surfaces[j].UV3.x,
                Surfaces[j].UV3.y,
                Surfaces[j].UV3.z);

            Printf("TextureFlags = 0x%04X\n", Surfaces[j].TextureFlags);
            Printf("UseEffects   = %u\n", Surfaces[j].UseEffects);
        }
    }


    // ------------------------------------------------------------
    // POLYGONS
    // Alle werden weiterhin geparst!
    // Ausgabe aber nur für Surface 1 / 2
    // ------------------------------------------------------------
    local int i = 0;
    local int k = 0;
    local int IsTarget = 0;
    
    for (i = 0; i < PolyCount; i++)
    {
        Polygon Poly(Vertices[i]);
    
        // Immer parsen – wichtig für die Synchronisation.
        DiskVertInfo DiskVerts(
            Surfaces[Poly.SurfaceIndex].Flags,
            Vertices[i]
        );
    
        // Nur Polygone der gesuchten Texturen ausgeben.
        IsTarget =
            (Surfaces[Poly.SurfaceIndex].Texture == 50) ||
            (Surfaces[Poly.SurfaceIndex].Texture == 51);
    
        if (IsTarget)
        {
            Printf("\n--- Polygon %d ---\n", i);
            Printf("SurfaceIndex = %d\n", Poly.SurfaceIndex);
            Printf("Texture = %d\n", Surfaces[Poly.SurfaceIndex].Texture);
            Printf("VertexCount = %d\n", Vertices[i].Count);

            Printf("Unknown1 = %d (0x%08X)\n", Poly.Unknown1, Poly.Unknown1);
            Printf("PlaneIndex = %d\n", Poly.PlaneIndex);
            Printf("LightmapW/H = %u / %u\n", Poly.LightmapWidth, Poly.LightmapHeight);
            Printf("Unknown2/3 = %d / %d\n", Poly.Unknown2, Poly.Unknown3);
            Printf("Unknown5 = %f\n", Poly.Unknown5);
            Printf("Unknown6 = %f\n", Poly.Unknown6);
            Printf("Center = (%f, %f, %f)\n", Poly.Center.x, Poly.Center.y, Poly.Center.z);
            Printf("Vertex.Unk1 = %d (0x%02X)\n", Vertices[i].Unk1, Vertices[i].Unk1);
    
            for (k = 0; k < Vertices[i].Count; k++)
            {
                Printf("  Vert=%d  U=%f  V=%f  Unk3=%02X%02X%02X%02X\n",
                    DiskVerts.Verts[k].Vert,
                    DiskVerts.Verts[k].UV_U,
                    DiskVerts.Verts[k].UV_V,
                    DiskVerts.Verts[k].Unknown3[0], DiskVerts.Verts[k].Unknown3[1],
                    DiskVerts.Verts[k].Unknown3[2], DiskVerts.Verts[k].Unknown3[3]);
            }
        }
    }
    
        
    


    // =====================================================
    // REST DES WORLDBSP
    // =====================================================

    if (NodeCount > 0) {
        Node Nodes[NodeCount];
    }

    if (UserPortalCount > 0) {
        UserPortal Portals[UserPortalCount];
    }

    Point Points[PointCount];

    PBlockTable BlockTable(PolyCount);

    int RootNodeIndex;
    int Sections;
};

struct TextureList {
    int Count;
    int Size;
    LTString Textures[Count] <optimize=false>;
};

struct WorldModel {
    local int64 startPos = FTell();
    int NextWorldItem;
    
    // Prüfen ob NextWorldItem gültig ist
    if (NextWorldItem > 0 && NextWorldItem < FileSize()) {
        WorldBSP BSPData;
        
        // Immer zu NextWorldItem springen nach dem Lesen
        // (NextWorldItem zeigt entweder auf nächstes Model oder ObjectHeader)
        FSeek(NextWorldItem);
    } else {
        Warning("Invalid NextWorldItem at position %Lx", startPos);
    }
};

struct WorldModelHeader {
    TextureList Textures;

    int Count;
    WorldModel model[Count] <optimize=false>;
};


struct WorldTreeNode {
  int Children;
    
};
/*
    {  PT_STRING = 0;
     PT_VECTOR = 1;
     PT_COLOR = 2;
     PT_REAL = 3;
     PT_FLAGS = 4;
     PT_BOOL = 5;
     PT_LONGINT = 6;
     PT_ROTATION = 7;  } 
*/
struct ObjectProperty {
    int NameIndex;
    char Code;
    ushort DataLength;
    
    switch(Code) {
        case 0: // String
        //LTString Value;
        int Value;
        break;
        case 1: // Vector
        case 2: // Color
        LTVector Value;
        break;
        case 3: // Float
        float Value;
        break;
        case 5: // Bool
        char Value;
        break;
        case 4: // Flags
        case 6: // Long Int
        uint Value;
        break;
        case 7: // Rotation
        LTQuaternion Value <bgcolor=0xFF33FF>;
        break;
    };
};


struct ObjectStringList {
    LTString Item;
};

struct WorldObject {
    ushort Count;
    int NameIndex;
    int PropertyCount;
/*
    int Unk3;
    short Unk4;
    short Unk5;
    short PropertyCount2;
    char Align;
  */  
  

    //LTString TypeString;
    //int PropertyCount;
    ObjectProperty Properties[PropertyCount] <optimize=false>;
};

struct WorldObjectHeader {
